{"file":"default-BtWxHhC9.js","mappings":";;;;;;;;;;;;;;;;;;;AAsDA,UAAM,YAAY,aAAA;AAClB,UAAM,QAAQ,SAAA;AAEd,UAAM,WAAW,SAAS,MAAM;AAAA,MAC9B,EAAE,IAAI,cAAc,OAAO,OAAO,MAAM,gBAAA;AAAA,MACxC,EAAE,IAAI,YAAY,OAAO,QAAQ,MAAM,OAAA;AAAA,MACvC,EAAE,IAAI,UAAU,OAAO,QAAQ,MAAM,cAAA;AAAA,MACrC,EAAE,IAAI,aAAa,OAAO,QAAQ,MAAM,SAAA;AAAA,IAAS,CAClD;AAED,UAAM,kBAAkB,SAAS,MAAM;AACrC,YAAM,OAAO,UAAU,MAAM;AAC7B,UAAI,SAAS,SAAU,QAAO;AAC9B,UAAI,SAAS,QAAS,QAAO;AAC7B,aAAO;AAAA,IACT,CAAC;AAED,aAAS,SAAS,MAAc;AAC9B,aAAO,MAAM,KAAK,WAAW,IAAI;AAAA,IACnC;;;AAxEO,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,+CAA2C,MAAA,CAAA,CAAA,GAAA;AACvC,UAAAC,MAAA,SAAA,EAAU,YAAU;;AAIX,cAAAC,mBAAAD,MAAA,YAAA,GAAA,EAAA,OAAM,uBAAA,GAAsB,MAAA,OAAA,CAAA;;AAW7BE,sBAAAF,MAAA,QAAA,IAAR,SAAI;;YACV,KAAK,KAAK;AAAA,YACV,IAAI,KAAK;AAAA,YACV,QAAM,sFACE,SAAS,KAAK,EAAE,IAAA,2CAAA,uDAAA;AAAA,UAAA;6BAL1B,CASW,GAAAG,QAAAC,UAAA,aAAA;;AAFOC,+BAAAF,QAAAG,YAAAC,wBAAA,KAAK,IAAI,GAAA,EAAE,OAAM,UAAA,GAAS,IAAA,GAAAH,UAAA,QAAA;AACvCD,uBAAA,IAAAK,eAAA,KAAK,KAAK,CAAA,EAAA;AAAA;;mBADbC,UAAA,GAAAC,YAA6CH,wBAA7B,KAAK,IAAI,GAAA,EAAE,OAAM,WAAS;AAAA,kCAAG,MAC7CI,gBAAG,KAAK,KAAK,GAAA,CAAA;AAAA,gBAAA;AAAA;;;;;gJAOAX,MAAA,eAAA,GAAe,yEAAA,CAAA,MACvBQ,eAAAR,MAAA,SAAA,EAAU,MAAM,MAAM,OAAM,CAAA,CAAA,wEAGcA,MAAA,SAAA,EAAU,MAAM,IAAI,0CAC5BQ,eAAAR,MAAA,SAAA,EAAU,QAAQ;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderComponent","_ssrRenderList","_push","_parent","_ssrRenderVNode","_createVNode","_resolveDynamicComponent","_ssrInterpolate","_openBlock","_createBlock","_toDisplayString"],"sources":["../../../../layouts/default.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen bg-slate-900 text-white flex\">\n    <aside v-if=\"authStore.isLoggedIn\" class=\"w-64 bg-slate-800 border-r border-slate-700 flex flex-col shrink-0\">\n      <div class=\"p-5 border-b border-slate-700\">\n        <div class=\"flex items-center gap-3\">\n          <div class=\"w-10 h-10 rounded-lg bg-sky-500/20 flex items-center justify-center\">\n            <MountainSnow class=\"w-5 h-5 text-sky-400\" />\n          </div>\n          <div>\n            <h1 class=\"text-sm font-bold text-white\">雪道巡查</h1>\n            <p class=\"text-xs text-slate-400\">风险上报系统</p>\n          </div>\n        </div>\n      </div>\n\n      <nav class=\"flex-1 p-3 space-y-1\">\n        <NuxtLink\n          v-for=\"item in navItems\"\n          :key=\"item.to\"\n          :to=\"item.to\"\n          class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all duration-200\"\n          :class=\"isActive(item.to) ? 'bg-sky-500/20 text-sky-400 font-medium' : 'text-slate-400 hover:text-white hover:bg-slate-700/50'\"\n        >\n          <component :is=\"item.icon\" class=\"w-4 h-4\" />\n          {{ item.label }}\n        </NuxtLink>\n      </nav>\n\n      <div class=\"p-4 border-t border-slate-700\">\n        <div class=\"flex items-center gap-3 mb-3\">\n          <div class=\"w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold\"\n               :class=\"roleAvatarClass\">\n            {{ authStore.user?.name?.charAt(0) }}\n          </div>\n          <div>\n            <p class=\"text-sm font-medium text-white\">{{ authStore.user?.name }}</p>\n            <p class=\"text-xs text-slate-400\">{{ authStore.roleName }}</p>\n          </div>\n        </div>\n        <button @click=\"handleLogout\" class=\"w-full text-left text-xs text-slate-400 hover:text-white transition-colors\">\n          退出登录\n        </button>\n      </div>\n    </aside>\n\n    <main class=\"flex-1 overflow-auto\">\n      <slot />\n    </main>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { MountainSnow, LayoutDashboard, Shield, AlertTriangle, Settings } from 'lucide-vue-next'\n\nconst authStore = useAuthStore()\nconst route = useRoute()\n\nconst navItems = computed(() => [\n  { to: '/dashboard', label: '工作台', icon: LayoutDashboard },\n  { to: '/patrols', label: '巡查管理', icon: Shield },\n  { to: '/risks', label: '风险上报', icon: AlertTriangle },\n  { to: '/settings', label: '系统管理', icon: Settings },\n])\n\nconst roleAvatarClass = computed(() => {\n  const role = authStore.user?.role\n  if (role === 'rental') return 'bg-emerald-500/20 text-emerald-400'\n  if (role === 'coach') return 'bg-purple-500/20 text-purple-400'\n  return 'bg-sky-500/20 text-sky-400'\n})\n\nfunction isActive(path: string) {\n  return route.path.startsWith(path)\n}\n\nfunction handleLogout() {\n  authStore.logout()\n  navigateTo('/login')\n}\n</script>\n"],"version":3}