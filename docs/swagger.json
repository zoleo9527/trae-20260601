                "produces": [
                    "application/json"
                ],
                "tags": [
                    "质检放行"
                ],
                "summary": "更新质检放行单状态",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "放行单ID",
                        "name": "id",
