                "responses": {
                    "200": {
                        "description": "更新成功，返回最新详情",
                        "schema": {
                            "$ref": "#/definitions/models.QualityRelease"
                        }
                    },
                    "400": {
                        "description": "请求参数错误",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "404": {
                        "description": "放行单不存在",
                        "schema": {
                            "type": "object"
                        }
                    }
                }
            }
        }
    },
