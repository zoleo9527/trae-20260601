    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sqlite3": "5.1.7",
    "swagger-ui-express": "5.0.1",
    "typeorm": "0.3.30",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.1.3",
    "@types/express": "4.17.21",
    "@types/node": "20.11.0",
