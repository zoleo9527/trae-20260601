{
  "name": "forklift-maintenance-system",
  "version": "1.0.0",
  "description": "叉车维保商-设备档案与保养计划系统",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "reset-data": "node server/scripts/resetData.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
