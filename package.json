{
  "name": "dorm-late-return-system",
  "version": "1.0.0",
  "description": "学生宿舍晚归登记与辅导员跟进系统",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "ts-node api/index.ts",
    "client": "vite",
    "build": "tsc -p api/tsconfig.json && vite build",
    "seed": "ts-node api/seed.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/node": "^20.10.5",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "vite": "^5.0.8",
    "concurrently": "^8.2.2"
  }
}