generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String
  avatarUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders    PurchaseOrder[]
  drawings        Drawing[]
  inspections     Inspection[]
  reportedExceptions Exception[] @relation("ExceptionReportedBy")
  closedExceptions   Exception[] @relation("ExceptionClosedBy")
  supplierFeedbacks SupplierFeedback[]
  attachmentUploads ExceptionAttachment[] @relation("AttachmentUploader")
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  contactName String
  email     String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  purchaseOrders PurchaseOrder[]
}

model Part {
  id        String   @id @default(cuid())
  partNumber String @unique
  name      String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drawings Drawing[]
  purchaseOrders PurchaseOrder[]
}

model Drawing {
  id            String   @id @default(cuid())
  partId        String
  part          Part     @relation(fields: [partId], references: [id])
  version       String
  revision      String?
  title         String
  description   String?
  status        String   @default("DRAFT")
  fileUrl       String?
  fileName      String?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  approvedBy    String?
  approvedAt    DateTime?
  changeLog     String?
  isObsolete    Boolean  @default(false)
  canUseOldVersion Boolean @default(false)
  obsoleteReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  drawingId     String?
  drawing       Drawing?  @relation(fields: [drawingId], references: [id])
  partId        String
  part          Part     @relation(fields: [partId], references: [id])
  quantity      Int
  unitPrice     Decimal?
  totalPrice    Decimal?
  status        String   @default("DRAFT")
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  expectedDeliveryDate DateTime?
  actualDeliveryDate DateTime?
  drawingConfirmed Boolean @default(false)
  drawingConfirmedAt DateTime?
  drawingConfirmedBy String?
  notes         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inspections Inspection[]
  exceptions  Exception[]
}

model Inspection {
  id              String   @id @default(cuid())
  orderId         String
  purchaseOrder   PurchaseOrder @relation(fields: [orderId], references: [id])
  inspectorId     String
  inspector       User     @relation(fields: [inspectorId], references: [id])
  quantityReceived Int
  quantityInspected Int
  status          String   @default("PENDING")
  inspectionDate  DateTime?
  reportUrl       String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inspectionItems InspectionItem[]
  exceptions      Exception[]
}

model InspectionItem {
  id           String   @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id])
  itemName     String
  specification String
  actualValue   String?
  isConforming Boolean
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Exception {
  id              String   @id @default(cuid())
  exceptionNumber String   @unique
  orderId         String
  purchaseOrder   PurchaseOrder @relation(fields: [orderId], references: [id])
  inspectionId    String?
  inspection       Inspection? @relation(fields: [inspectionId], references: [id])
  reportedById      String
  reportedBy       User     @relation("ExceptionReportedBy", fields: [reportedById], references: [id])
  title           String
  description     String
  status          String   @default("REPORTED")
  type            String
  rootCause       String?
  disposition     String?
  concessionDecision String?
  reworkResponsible String?
  reworkCost      Decimal?
  closedById      String?
  closedBy          User? @relation("ExceptionClosedBy", fields: [closedById], references: [id])
  closedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplierFeedbacks SupplierFeedback[]
  attachments    ExceptionAttachment[]
}

model SupplierFeedback {
  id           String   @id @default(cuid())
  exceptionId  String
  exception    Exception @relation(fields: [exceptionId], references: [id])
  supplierId   String
  supplier      User     @relation(fields: [supplierId], references: [id])
  content        String
  rootCauseAnalysis String?
  correctiveAction String?
  preventiveAction String?
  attachmentUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ExceptionAttachment {
  id           String   @id @default(cuid())
  exceptionId  String
  exception    Exception @relation(fields: [exceptionId], references: [id])
  fileName     String
  fileUrl      String
  fileType     String?
  uploadedById  String
  uploadedBy    User     @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}
