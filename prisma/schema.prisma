generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  role      String
  phone     String
  createdAt DateTime @default(now())
  
  vehiclesAsManager    Vehicle[]         @relation("ManagerVehicles")
  vehiclesAsAssessor   Vehicle[]         @relation("AssessorVehicles")
  vehiclesAsFinance    Vehicle[]         @relation("FinanceVehicles")
  inspectionReports    InspectionReport[] @relation("InspectorReports")
  preparationTasksAsAssignee PreparationTask[] @relation("TaskAssignees")
  preparationTasksAsCreator  PreparationTask[] @relation("TaskCreators")
  operationRecords     OperationRecord[] @relation("ActorOperations")
  accidentAnnotationsAsAnnotator  AccidentAnnotation[] @relation("AnnotatorAnnotations")
  accidentAnnotationsAsVerifier   AccidentAnnotation[] @relation("VerifierAnnotations")
  financeRecordsAsAssignee  FinanceRecord[] @relation("FinanceAssignees")
  financeRecordsAsCreator   FinanceRecord[] @relation("FinanceCreators")
  timelineEvents       TimelineEvent[] @relation("ActorEvents")
  documentReminders    DocumentReminder[] @relation("ReminderAssignees")
}

model Vehicle {
  id                String   @id @default(uuid())
  licensePlate      String   @unique
  brand             String
  model             String
  year              Int
  mileage           Int
  color             String
  purchasePrice     Int
  estimatedValue    Int
  status            String
  managerId         String
  assessorId        String?
  financeId         String?
  currentAssigneeId String
  currentAssigneeRole String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  manager           User     @relation("ManagerVehicles", fields: [managerId], references: [id])
  assessor          User?    @relation("AssessorVehicles", fields: [assessorId], references: [id])
  finance           User?    @relation("FinanceVehicles", fields: [financeId], references: [id])
  
  statusHistory     StatusHistory[]
  inspectionReports InspectionReport[]
  preparationTasks  PreparationTask[]
  timelineEvents    TimelineEvent[]
  financeRecords    FinanceRecord[]
  operationRecords  OperationRecord[]
  costBudgets       CostBudget[]
  documentReminders DocumentReminder[]
}

model StatusHistory {
  id            String   @id @default(uuid())
  vehicleId     String
  status        String
  changedBy     String
  changedByName String
  changedAt     DateTime @default(now())
  note          String
  
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  @@index([vehicleId])
}

model InspectionReport {
  id                String   @id @default(uuid())
  vehicleId         String
  inspectorId       String
  overallScore      Float
  conclusion        String
  recommendations   String
  hasAccidentRecords Boolean @default(false)
  accidentCount     Int      @default(0)
  criticalIssues    String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  inspector         User     @relation("InspectorReports", fields: [inspectorId], references: [id])
  items             InspectionItem[]
  accidentAnnotations AccidentAnnotation[]
  
  @@index([vehicleId])
}

model InspectionItem {
  id              String   @id @default(uuid())
  reportId        String
  category        String
  name            String
  description     String
  status          String
  score           Int
  note            String
  inspectorId     String
  inspectedAt     DateTime @default(now())
  isAccident      Boolean  @default(false)
  
  report          InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  accidentAnnotations AccidentAnnotation[]
  
  @@index([reportId])
}

model AccidentAnnotation {
  id            String   @id @default(uuid())
  reportId      String
  itemId        String
  severity      String
  description   String
  location      String
  annotatedBy   String
  annotatedAt   DateTime @default(now())
  verifiedBy    String?
  verifiedAt    DateTime?
  note          String
  
  report        InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  item          InspectionItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  annotator     User             @relation("AnnotatorAnnotations", fields: [annotatedBy], references: [id])
  verifier      User?            @relation("VerifierAnnotations", fields: [verifiedBy], references: [id])
  
  @@index([reportId])
  @@index([itemId])
}

model PreparationTask {
  id              String   @id @default(uuid())
  vehicleId       String
  title           String
  description     String
  cost            Int
  estimatedCost   Int
  estimatedHours  Int
  actualHours     Int      @default(0)
  status          String
  assigneeId      String
  assigneeName    String
  dueDate         DateTime
  completedAt     DateTime?
  note            String
  createdBy       String
  createdByName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignee        User     @relation("TaskAssignees", fields: [assigneeId], references: [id])
  creator         User     @relation("TaskCreators", fields: [createdBy], references: [id])
  costHistory     TaskCostHistory[]
  
  @@index([vehicleId])
  @@index([assigneeId])
}

model TaskCostHistory {
  id            String   @id @default(uuid())
  taskId        String
  cost          Int
  changedBy     String
  changedByName String
  changedAt     DateTime @default(now())
  reason        String
  
  task          PreparationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  @@index([taskId])
}

model TimelineEvent {
  id          String   @id @default(uuid())
  vehicleId   String
  type        String
  title       String
  description String
  actorId     String
  actorName   String
  createdAt   DateTime @default(now())
  metadata    Json?
  
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  actor       User     @relation("ActorEvents", fields: [actorId], references: [id])
  
  @@index([vehicleId])
}

model FinanceRecord {
  id              String   @id @default(uuid())
  vehicleId       String
  type            String
  documentName    String
  status          String
  assigneeId      String
  assigneeName    String
  dueDate         DateTime
  remindedCount   Int      @default(0)
  lastRemindedAt  DateTime?
  note            String
  createdBy       String
  createdByName   String
  updatedAt       DateTime @updatedAt
  
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignee        User     @relation("FinanceAssignees", fields: [assigneeId], references: [id])
  creator         User     @relation("FinanceCreators", fields: [createdBy], references: [id])
  
  @@index([vehicleId])
  @@index([assigneeId])
}

model CostBudget {
  vehicleId         String   @id
  estimatedBudget   Int
  actualCost        Int      @default(0)
  warningThreshold  Float    @default(0.8)
  overrunThreshold  Float    @default(1.0)
  lastUpdatedBy     String
  lastUpdatedAt     DateTime @updatedAt
  
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model DocumentReminder {
  id            String   @id @default(uuid())
  vehicleId     String
  recordId      String
  documentName  String
  status        String
  assigneeId    String
  dueDate       DateTime
  remindedAt    DateTime?
  completedAt   DateTime?
  note          String
  
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignee      User     @relation("ReminderAssignees", fields: [assigneeId], references: [id])
  
  @@index([vehicleId])
  @@index([assigneeId])
}

model OperationRecord {
  id            String   @id @default(uuid())
  vehicleId     String
  type          String
  action        String
  previousValue String?
  newValue      String?
  actorId       String
  actorName     String
  actorRole     String
  createdAt     DateTime @default(now())
  note          String
  metadata      Json?
  
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  actor         User     @relation("ActorOperations", fields: [actorId], references: [id])
  
  @@index([vehicleId])
  @@index([actorId])
  @@index([createdAt])
}

model StatusTransitionConfig {
  id              String   @id @default(uuid())
  fromStatus      String
  toStatus        String
  requiredRole    String
  allowedRoles    String[]
  requiredFields  String[]
  autoNotifyRoles String[]
  timeoutHours    Int
  description     String
}