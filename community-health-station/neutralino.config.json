{
  "applicationId": "com.community-health.station",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "window.*",
    "storage.*",
    "filesystem.*",
    "debug.*"
  ],
  "modes": {
    "window": {
      "title": "社区卫生站 - 家庭签约与档案建档",
      "width": 1366,
      "height": 820,
      "minWidth": 1024,
      "minHeight": 600,
      "center": true
    }
  },
  "cli": {
    "binaryName": "community-health-station",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "5.4.0",
    "clientVersion": "5.4.0"
  }
}
